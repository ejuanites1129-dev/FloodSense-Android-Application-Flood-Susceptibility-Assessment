DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
FLOODSENSE_GIS_ENABLED=true
DATABASE_NAME=floodsense
DATABASE_USER=floodsense
DATABASE_PASSWORD=choose-a-local-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\17\bin\libgdal-35.dll
GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\17\bin\libgeos_c.dll

# Resident authentication. Keep Google blank to disable it gracefully.
FLOODSENSE_RESIDENT_APP_PUBLIC_URL=http://localhost:3000
FLOODSENSE_EMAIL_VERIFICATION_EXPIRY_HOURS=24
FLOODSENSE_ACCOUNT_DELETION_GRACE_DAYS=30
FLOODSENSE_PASSWORD_RESET_TIMEOUT=3600
FLOODSENSE_LOGIN_RATE=10/min
FLOODSENSE_REGISTRATION_RATE=5/hour
FLOODSENSE_PASSWORD_RESET_RATE=5/hour
FLOODSENSE_VERIFICATION_RATE=5/hour
FLOODSENSE_GOOGLE_AUTH_RATE=10/min
FLOODSENSE_TOKEN_REFRESH_RATE=30/min
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Local development prints messages to the server console. Deployment may set
# SMTP values through its secret manager; never commit provider credentials.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=FloodSense <no-reply@localhost>
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
